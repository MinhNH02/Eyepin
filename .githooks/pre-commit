#!/bin/sh
# Không commit trực tiếp lên main: main chỉ nhận thay đổi qua PR từ develop (CLAUDE.md, mục "Quy ước git").

branch=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ "$branch" = "main" ]; then
  echo "Không commit trực tiếp lên main. Chuyển sang develop: git checkout develop" >&2
  exit 1
fi
exit 0
